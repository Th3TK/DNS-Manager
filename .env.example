# -------------------------------------------------------------------------
# DNS PROVIDER SELECTION
# -------------------------------------------------------------------------

# Reserved for future support of other DNS providers.
# Options: powerdns
DNS_PROVIDER=powerdns

# -------------------------------------------------------------------------
# POWERDNS OPTIONS
# Required if DNS_PROVIDER=powerdns
# -------------------------------------------------------------------------

# PowerDNS REST API url
POWERDNS_API_URL=http://your.powerdns.api.url:8081/api/v1

# Your PowerDNS REST API private key
POWERDNS_API_KEY=your-api-private-key

# Id of the PowerDNS server to manage
POWERDNS_SERVER_ID=id-of-your-powerdns-server

# -------------------------------------------------------------------------
# POSTGRESQL DATABASE OPTIONS
# -------------------------------------------------------------------------

# Connection URL to your PostgreSQL database
DATABASE_URL=postgresql://username:password@host:port/database

# -------------------------------------------------------------------------
# APP OPTIONS
# -------------------------------------------------------------------------

# Secret key used to sign and verify API access tokens.
# Replace this value with a randomly generated secret.
# Generate with: openssl rand -hex 32
AUTHENTICATION_SECRET_KEY=your-api-secret-key

# Username for the application's initial administrator account
ADMIN_USERNAME=admin

# Password for the application's initial administrator account
ADMIN_PASSWORD=password

# Interval, in seconds, for a background job that periodically checks all active records
# and provides the frontend with their statuses.
# Defaults to 300 seconds (5 minutes) if not set.
CHECK_INTERVAL_SECONDS=300

# Name of the zone that accepts automatically generated hostnames from the Traefik/Docker watcher.
# Hostname labels outside this zone are ignored and logged.
# If empty, no hostnames are accepted.
MANAGED_ZONE=

# -------------------------------------------------------------------------
# WATCHER INSTANCE OPTIONS
# -------------------------------------------------------------------------

# Watcher instance identificator
WATCHER_NAME=name-of-the-instance

# IP address of the Traefik service host
TRAEFIK_HOST_IP=10.0.0.1

# -------------------------------------------------------------------------
# DEBUG/ADVANCED
# All variables in this section have preset defaults in the application.
# -------------------------------------------------------------------------

# Log level for the backend
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO
LOG_LEVEL=INFO

# Determines how long should the DNS zones and records remain  in the trash before being permanently removed.
# Defaults to 2592000 seconds (30 days) if not set.
ITEM_TRASH_INTERVAL_SECONDS=2592000

# Algorithm used to sign JWT access tokens.
# Defaults to HS256 if not set.
AUTHENTICATION_ALGORITHM=HS256

# Lifetime of an access token in seconds. Defaults to 3600 (1 hour).
ACCESS_TOKEN_LIFETIME_SECONDS=3600

# Lifetime of a refresh token in seconds. Defaults to 259200 (72 hours).
REFRESH_TOKEN_LIFETIME_SECONDS=259200